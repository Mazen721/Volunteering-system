PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/volunteer_hours?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@mnu.edu.eg
ADMIN_PASSWORD=replace-with-strong-admin-password
# Optional comma-separated email domains allowed for student self-registration (leave empty to allow all domains)
ALLOWED_EMAIL_DOMAINS=

# Demo accounts seeded by `npm run seed` (all share ADMIN_PASSWORD):
